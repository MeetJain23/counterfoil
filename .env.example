# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Razorpay: TEST MODE ONLY ---
# The app refuses to boot if RAZORPAY_KEY_ID does not start with "rzp_test_".
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- LLM ---
# Provider: gemini | anthropic. Left blank, it is inferred from whichever key
# is set below, preferring gemini.
COUNTERFOIL_LLM_PROVIDER=gemini

# Gemini free tier: aistudio.google.com/apikey, no card required.
GEMINI_API_KEY=

# Anthropic: console.anthropic.com, prepaid credit required.
ANTHROPIC_API_KEY=

# Blank uses the default for the chosen provider
# (gemini-2.5-flash / claude-haiku-4-5).
COUNTERFOIL_LLM_MODEL=

# replay never calls out and needs no key, which is how the committed
# fixtures make the eval reproducible for anyone who clones this.
COUNTERFOIL_LLM_MODE=replay          # replay | record | live
COUNTERFOIL_LLM_FIXTURE_DIR=llm_fixtures

# --- hard spend ceiling (USD). A run halts when this is reached. ---
COUNTERFOIL_SPEND_CAP_USD=2.00

# --- execution safety ---
COUNTERFOIL_DRY_RUN=true             # true = no outbound side effects, ever
COUNTERFOIL_ENV=dev

# --- storage ---
DATABASE_URL=postgresql+psycopg://counterfoil:counterfoil@localhost:5432/counterfoil
