# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Razorpay: TEST MODE ONLY ---
# The app refuses to boot if RAZORPAY_KEY_ID does not start with "rzp_test_".
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=
COUNTERFOIL_LLM_MODEL=claude-haiku-4-5
COUNTERFOIL_LLM_MODE=replay          # replay | record | live
COUNTERFOIL_LLM_FIXTURE_DIR=llm_fixtures

# --- hard spend ceiling (USD). A run halts when this is reached. ---
COUNTERFOIL_SPEND_CAP_USD=2.00

# --- execution safety ---
COUNTERFOIL_DRY_RUN=true             # true = no outbound side effects, ever
COUNTERFOIL_ENV=dev

# --- storage ---
DATABASE_URL=postgresql+psycopg://counterfoil:counterfoil@localhost:5432/counterfoil
